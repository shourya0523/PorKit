{
  "name": "porkit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @porkit/web dev",
    "build": "pnpm -r --filter @porkit/shared --filter @porkit/sdk --filter @porkit/widget --filter @porkit/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.9.3"
  }
}
